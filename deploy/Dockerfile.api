# Image de l'API (moteur + FastAPI). Contexte de build : racine du projet.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN useradd --create-home --uid 10001 pkp
WORKDIR /app
COPY engine ./engine
COPY api ./api
COPY contenu ./contenu
RUN pip install ./engine "./api[postgres]" \
 && python -m app.contenu verifier --dossier ./contenu

WORKDIR /app/api
USER pkp
EXPOSE 8000

# 1 seul worker : la limitation des connexions est en mémoire (voir app/limitation.py).
# --proxy-headers : l'IP du client vient de Caddy. Sûr car l'API n'est joignable
# que depuis le réseau Docker interne (aucun port publié).
# Au démarrage : migrations, puis import du contenu pédagogique (idempotent).
CMD ["sh", "-c", "alembic upgrade head && python -m app.contenu importer && exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips='*'"]
