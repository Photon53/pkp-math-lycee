# Caddy obtient et renouvelle seul le certificat HTTPS (Let's Encrypt) pour ce domaine.
{$PKP_DOMAINE} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# style-src 'unsafe-inline' : KaTeX positionne les symboles des formules avec des attributs style.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Même convention qu'en développement (vite.config.js) : /api/x -> API /x
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# Fichiers du front : leur nom contient l'empreinte de leur contenu (Vite), ils ne changent jamais.
	# Le téléphone les garde un an au lieu de les redemander à chaque visite (seulement s'ils existent).
	@empreintes {
		path /assets/*
		file {
			root /srv
		}
	}
	header @empreintes Cache-Control "public, max-age=31536000, immutable"
	# index.html (et les routes du front) : toujours revalidé, pour obtenir la nouvelle version après une mise à jour.
	@pages not path /assets/* /api/*
	header @pages Cache-Control "no-cache"

	# Un ancien fichier disparu après une mise à jour : 404, jamais index.html à sa place
	# (le front recharge alors la page, voir web/src/miseAJour.js).
	handle /assets/* {
		root * /srv
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
