# Copier en .env (jamais versionné) et remplir.

# Domaine public ; ses DNS doivent pointer vers ce serveur (ports 80 et 443 ouverts).
PKP_DOMAINE=maths.mon-lycee.fr

# Valeurs aléatoires, à générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# (token_urlsafe : pas de caractère à échapper dans l'URL de connexion PostgreSQL)
PKP_SECRET_KEY=
PKP_DB_MOT_DE_PASSE=

# Durée de conservation des données d'un élève inactif (jours).
PKP_RETENTION_JOURS=365
